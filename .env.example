# ==============================================================================
# AI-Powered Internship Management & Mentorship System - Configuration
# ==============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true

# Security (Change in production!)
SECRET_KEY=super-secret-jwt-key-for-internship-mentorship-system-2026-secure!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: MySQL 8 (Falls back automatically to SQLite if connection fails)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/internship_system
# Zero-configuration SQLite alternative:
# DATABASE_URL=sqlite:///./internship_system.db

# AI Provider Configuration ('mock', 'gemini', 'openai')
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=45

# Email Automation ('mock', 'smtp', 'gmail_api')
EMAIL_PROVIDER=mock
EMAIL_SENDER=internships@techcorp.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google Calendar & Meet Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback
GOOGLE_CALENDAR_ID=primary

# Upload & Certificate Storage
MAX_UPLOAD_SIZE_BYTES=20971520

# Localization
TIMEZONE=Asia/Kolkata

# Service URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
